# MySQL database created before launching the application.
DATABASE_URL=mysql+pymysql://clinic:your_password@localhost:3306/sanjeevani
GROQ_API_KEY=YOUR_NEW_GROQ_KEY
# REQUIRED for Admin/Super Admin MCP sign-in. Generate: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_SESSION_SECRET=REPLACE_WITH_GENERATED_SECRET_AT_LEAST_32_CHARS
# Set true when served via HTTPS in production.
COOKIE_SECURE=false
GROQ_TEXT_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
